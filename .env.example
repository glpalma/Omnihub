# Copy this file to .env and adjust values for local development
# docker-compose.yml reads from .env automatically

POSTGRES_USER=omnihub
POSTGRES_PASSWORD=omnihub
POSTGRES_DB=omnihub

DATABASE_URL=postgresql+asyncpg://omnihub:omnihub@postgres:5432/omnihub
REDIS_URL=redis://redis:6379

APP_ENV=development
DEBUG=false
